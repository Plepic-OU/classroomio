  posthog [label="PostHog\n[External System]\nAnalytics" shape=box style=filled fillcolor="#999999" fontcolor="white" fontname="Arial" fontsize=11]
  supabase_auth [label="Supabase Auth\n[External System]\nJWT auth" shape=box style=filled fillcolor="#999999" fontcolor="white" fontname="Arial" fontsize=11]

  // Relationships
  teacher -> dashboard [label="HTTPS" fontsize=9 fontname="Arial"]
